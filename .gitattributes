* text=auto
*.aedt binary
*.aedtz binary
*.FCStd -text
*.zip -text
*.png -text
*.jpg -text
*.pdf binary
*.kicad_pcb text eol=lf
*.md text eol=lf
*.py text eol=lf
# Preservar os bytes dos arquivos de engenharia exportados pelos aplicativos.
*.s[0-9]*p -text whitespace=-blank-at-eol,-blank-at-eof
*.step -text whitespace=-blank-at-eol,-blank-at-eof
*.stp -text whitespace=-blank-at-eol,-blank-at-eof
*.dxf -text whitespace=-blank-at-eol,-blank-at-eof
*.csv -text whitespace=-blank-at-eol,-blank-at-eof
freecad/**/*.json -text whitespace=-blank-at-eol,-blank-at-eof
resultados/**/*.txt -text whitespace=-blank-at-eol,-blank-at-eof
resultados/**/*.json -text whitespace=-blank-at-eol,-blank-at-eof
# Evidencias e nativos P2M21: manifesto confere exatamente os bytes exportados.
projetos/P2M21/**/*.json -text whitespace=-blank-at-eol,-blank-at-eof
projetos/P2M21/**/*.txt -text whitespace=-blank-at-eol,-blank-at-eof
projetos/P2M21/**/*.kicad_pcb -text whitespace=cr-at-eol
projetos/P2M21/**/*.kicad_pro -text whitespace=cr-at-eol
# Compact HFSS mesher diagnostic logs, retained byte-for-byte.
projetos/P2M21/centro_sem_refinamento/evidencias/*.log -text whitespace=-blank-at-eol,-blank-at-eof
projetos/P2M21/**/*.acf -text whitespace=cr-at-eol
projetos/P2M21/**/*.svg -text whitespace=-blank-at-eol,-blank-at-eof
# Saidas de fabricacao da placa 2_elementos: preservar o manifesto byte a byte.
projetos/P2M21/kicad/2_elementos/gerbers/* -text whitespace=-blank-at-eol,-blank-at-eof
projetos/P2M21/kicad/4_elementos/gerbers/* -text whitespace=-blank-at-eol,-blank-at-eof
# Evidencias do estudo P2S13: preservar os bytes usados no manifesto.
projetos/P2S13/**/*.json -text whitespace=-blank-at-eol,-blank-at-eof
projetos/P2S13/**/*.txt -text whitespace=-blank-at-eol,-blank-at-eof
projetos/P2S13/**/*.acf -text whitespace=cr-at-eol
# Script CAD gerado e arquivado como evidencia no manifesto P2S13.
projetos/P2S13/seis_elementos/celula2_simetrica/criar_cad.py -text whitespace=cr-at-eol
projetos/P2S13/casamento_placa2/**/criar_cad.py -text whitespace=cr-at-eol
# Preservar nativos/CAM C07 e seus hashes de fabricacao.
projetos/P2S13/kicad/**/*.kicad_pcb -text whitespace=cr-at-eol
projetos/P2S13/kicad/**/*.kicad_pro -text whitespace=cr-at-eol
projetos/P2S13/kicad/**/gerbers/* -text whitespace=-blank-at-eol,-blank-at-eof
projetos/P2S13/kicad/**/*.svg -text whitespace=-blank-at-eol,-blank-at-eof
# Preservar nativos e CAM da revisao C08/radome, fora da pasta KiCad historica.
projetos/P2S13/fabricavel_radome/**/*.kicad_pcb -text whitespace=cr-at-eol
projetos/P2S13/fabricavel_radome/**/*.kicad_pro -text whitespace=cr-at-eol
projetos/P2S13/fabricavel_radome/**/gerbers/* -text whitespace=-blank-at-eol,-blank-at-eof
# R17: bytes exatos de CAD, campos exportados e evidencias do pacote.
projetos/P2S13/mecanica_R17/** -text whitespace=-blank-at-eol,-blank-at-eof
projetos/P2S13/comparacao_refletor_R17/** -text whitespace=-blank-at-eol,-blank-at-eof
projetos/P2S13/mecanica_R17/**/*.step -diff
projetos/P2S13/mecanica_R17/**/*.stp -diff
# P2M19: preservar exatamente o pacote e os hashes de engenharia.
projetos/P2M19/centro_16x2_88mm/** -text whitespace=-blank-at-eol,-blank-at-eof
